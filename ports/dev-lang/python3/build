tar xJf Python-3.13.5.tar.xz
cd Python-3.13.5
# The optional stdlib modules must not auto-detect the HOST: on foreign
# roots the read-only host binds expose libreadline/libbz2/liblzma/
# libsqlite3/ncurses/libgdbm/libuuid, and configure would happily link
# them undeclared (gate-fatal). Only openssl/libffi/expat/zlib are
# declared, so everything else is pre-seeded "n/a" (detection skipped,
# module not built).
py_cv_module_readline=n/a \
py_cv_module__bz2=n/a \
py_cv_module__lzma=n/a \
py_cv_module__sqlite3=n/a \
py_cv_module__curses=n/a \
py_cv_module__curses_panel=n/a \
py_cv_module__gdbm=n/a \
py_cv_module__dbm=n/a \
py_cv_module__uuid=n/a \
py_cv_module_nis=n/a \
py_cv_module__tkinter=n/a \
./configure --prefix=/usr --enable-shared \
    --with-ensurepip=no \
    --with-openssl=/pkg/deps/openssl/usr \
    CPPFLAGS="-I/pkg/deps/libffi/usr/include -I/pkg/deps/expat/usr/include -I/pkg/deps/zlib/usr/include" \
    LDFLAGS="-L/pkg/deps/libffi/usr/lib -L/pkg/deps/expat/usr/lib -L/pkg/deps/zlib/usr/lib -Wl,-rpath,/usr/lib"
make
