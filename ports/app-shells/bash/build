tar xzf bash-5.3.tar.gz
cd bash-5.3
# bash's bundled readline wants a termcap library; point it at the
# pkg-built ncurses. termcap/tinfo probes are pre-seeded "no": otherwise
# the HOST's libtermcap/libtinfo win through the read-only host binds
# (undeclared linkage, gate-fatal) and -lncursesw is never tried.
ac_cv_lib_termcap_tgetent=no ac_cv_lib_tinfo_tgetent=no \
./configure --prefix=/usr --disable-nls --without-bash-malloc \
    CPPFLAGS="-I/pkg/deps/ncurses/usr/include" \
    LDFLAGS="-L/pkg/deps/ncurses/usr/lib"
make
