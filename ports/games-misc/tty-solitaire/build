# Plain-Makefile game against ncurses. The Makefile's own LDFLAGS
# (-lncursesw on Linux) is lost to a command-line override, so our
# override must carry it.
tar xzf tty-solitaire-1.3.1.tar.gz
cd tty-solitaire-1.3.1
make CC=cc \
    CFLAGS="-O2 -std=c99 -fcommon -I/pkg/deps/ncurses/usr/include" \
    LDFLAGS="-L/pkg/deps/ncurses/usr/lib -Wl,-rpath,/usr/lib -lncursesw"
