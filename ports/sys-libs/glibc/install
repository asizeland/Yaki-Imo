make -C glibc-build DESTDIR="$PKGDIR" install
# The loader cache is a generated host artifact, not package content:
# linking the build-sandbox copy over the live /etc/ld.so.cache would
# drop every directory the live ld.so.conf knew. Activation regenerates
# the live cache instead (see pkg-build's staging).
rm -f "$PKGDIR/etc/ld.so.cache"
# Scan-order drop-in: our libdir FIRST, so on a foreign root (another
# libc under a distro triarch dir like /usr/lib/x86_64-linux-gnu) the
# cache resolves libc.so.6 & co. to THIS glibc — loader and libc stay a
# consistent pair and foreign binaries keep working via forward compat.
mkdir -p "$PKGDIR/etc/ld.so.conf.d"
printf '/usr/lib\n/usr/lib64\n' > "$PKGDIR/etc/ld.so.conf.d/00-yakimo-glibc.conf"
