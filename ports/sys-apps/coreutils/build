tar xJf coreutils-9.12.tar.xz
cd coreutils-9.12
# --without-selinux / --without-openssl: selinux isn't in the tree,
# and openssl's libcrypto would be used by cksum — the host's would
# leak in undeclared (gate-fatal). gmp IS declared.
./configure --prefix=/usr --disable-nls --without-selinux --without-openssl
make
