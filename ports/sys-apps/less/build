tar xzf less-643.tar.gz
cd less-643
# tinfo/tinfow must probe "not found": the packaged ncurses builds
# ncursesw only, and on a foreign host configure would otherwise pick up
# the HOST's libtinfo through the read-only host binds (undeclared
# linkage, rightly gate-fatal). less then falls through to -lncursesw.
ac_cv_lib_tinfow_tgoto=no ac_cv_lib_tinfo_tgoto=no \
./configure --prefix=/usr \
    CPPFLAGS="-I/pkg/deps/ncurses/usr/include" \
    LDFLAGS="-L/pkg/deps/ncurses/usr/lib -Wl,-rpath,/usr/lib"
make
