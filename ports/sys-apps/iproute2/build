tar xJf iproute2-6.15.0.tar.xz
cd iproute2-6.15.0
./configure
# No Berkeley DB or SELinux in the tree: arpd and ss's selinux support
# would otherwise link the HOST's libdb/libselinux through the read-only
# host binds (undeclared, gate-fatal).
sed -i -e 's/^HAVE_BERKELEY_DB.*/HAVE_BERKELEY_DB=n/' \
       -e 's/^HAVE_SELINUX.*/HAVE_SELINUX=n/' \
       -e '/^LDLIBS += -lselinux/d' \
       -e '/^CFLAGS += -DHAVE_SELINUX/d' \
    config.mk
make PREFIX=/usr SBINDIR=/usr/sbin
