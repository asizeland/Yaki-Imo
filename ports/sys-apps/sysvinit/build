tar xJf sysvinit-3.14.tar.xz
cd sysvinit-3.14
# Only src/: the top-level Makefile builds man/ first, which needs
# pod2man (perl) — deliberately not in the build sandbox. The tree's
# man-pages package already carries the documentation.
#
# sulogin needs <crypt.h> (libxcrypt), which is not packaged yet; drop
# it until then. The command-line SBIN overrides the Makefile's default
# list (which adds sulogin + bootlogd when DISTRO is unset).
make -C src SBIN="init halt shutdown runlevel killall5 fstab-decode logsave bootlogd"
