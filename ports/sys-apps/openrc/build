tar xzf openrc-0.64.1.tar.gz
export PATH="/pkg/deps/meson/usr/bin:/pkg/deps/ninja/usr/bin:/pkg/deps/python3/usr/bin:/pkg/deps/pkgconf/usr/bin:$PATH"
# Release archives have no VCS metadata. Generate both version files from
# the project version so a surrounding checkout cannot leak its revision.
sed -i \
    -e "s/version_h = vcs_tag(input : 'version.h.in', output : 'version.h')/version_conf = configuration_data()\nversion_conf.set('VCS_TAG', meson.project_version())\nversion_h = configure_file(input : 'version.h.in', output : 'version.h', configuration : version_conf)/" \
    -e "s/vcs_tag(input : 'version.in', output : 'version')/configure_file(input : 'version.in', output : 'version', configuration : version_conf)/" \
    openrc-0.64.1/src/shared/meson.build
meson setup openrc-0.64.1 openrc-build \
    --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var \
    --buildtype=release \
    -Dshell=/bin/sh \
    -Daudit=disabled -Dselinux=disabled -Dpam=false \
    -Dnewnet=false -Dsysvinit=false \
    -Dbash-completions=false -Dzsh-completions=false \
    -Dpkgconfig=false
ninja -C openrc-build
