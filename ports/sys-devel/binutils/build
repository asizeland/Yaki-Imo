tar xJf binutils-2.45.tar.xz
mkdir binutils-build
cd binutils-build
# --without-zstd: compressed debug sections are optional, and the
# host's libzstd would leak in undeclared (gate-fatal).
../binutils-2.45/configure \
    --prefix=/usr \
    --disable-nls \
    --disable-werror \
    --disable-gprofng \
    --without-zstd \
    --enable-plugins \
    --enable-ld=default \
    --enable-shared
make
