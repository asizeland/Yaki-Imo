make -C eudev-3.2.14 DESTDIR="$PKGDIR" install

mkdir -p "$PKGDIR/etc/init.d"
cat > "$PKGDIR/etc/init.d/udev" <<'EOF'
#!/sbin/openrc-run

supervisor=supervise-daemon
description="eudev device manager"
command="/usr/sbin/udevd"

depend() {
	provide dev
	need devfs sysfs
	before fsck
}

start_pre() {
	if [ -e /proc/sys/kernel/hotplug ]; then
		echo "" > /proc/sys/kernel/hotplug
	fi
	checkpath -q -d -m 0755 /run/udev
}

start_post() {
	udevadm trigger --action=add --type=subsystems
	udevadm trigger --action=add --type=devices
	udevadm settle
}
EOF
chmod 0755 "$PKGDIR/etc/init.d/udev"
